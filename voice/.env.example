# Copy to voice/.env to change the voice engines. All optional.

# Speech-to-text model: tiny-int8 (fastest) · base-int8 · small-int8 (default, good Arabic) · medium-int8 (best, slow on CPU)
WHISPER_MODEL=small-int8

# After the first successful start (models downloaded), set this to true so the
# speech-to-text container never contacts the internet again.
WHISPER_OFFLINE=false

# Default Piper voice. Others (e.g. the Arabic voice set in Haris → Configure) are
# downloaded the first time they are used.
PIPER_VOICE=en_GB-alan-medium
